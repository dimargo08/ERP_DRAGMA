# Producción: copia este archivo como .env o define estas variables en cPanel.
NODE_ENV=production
PORT=4000

# Orígenes permitidos para CORS, separados por coma. Si el frontend se sirve
# desde este mismo dominio (recomendado), puede quedar vacío.
CORS_ORIGIN=

DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_bd
DB_PASS=clave_bd
DB_NAME=dragma_erp

# Genera una clave: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Solo para el script `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
